# Nebius Token Factory
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model tiers. Run `python scripts/list_models.py` and paste the Nemotron IDs here.
NEMO_MODEL_FAST=
NEMO_MODEL_STANDARD=
NEMO_MODEL_DEEP=

# Stand-in model while Nemotron credits are pending (Claude via the Anthropic API).
# Get a key at console.anthropic.com. This is separate from a Claude.ai subscription.
ANTHROPIC_API_KEY=
# Force a provider: nebius | claude | mock. Leave empty to auto-pick:
# Nebius if configured, else Claude if a key is set, else the offline mock.
NEMO_PROVIDER=

# Tavily (web research tool and the Best Use of Tavily prize)
TAVILY_API_KEY=

NEMO_DB_PATH=nemo_memory.sqlite3
